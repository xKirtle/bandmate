{
  "name": "bandmate-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && touch dist/.gitkeep",
    "check": "svelte-check --tsconfig ./tsconfig.json",
